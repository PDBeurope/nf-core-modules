nextflow_process {

    name "Test Process PDBESIFTS_SEQUENCEMATCH"
    script "../main.nf"
    process "PDBESIFTS_SEQUENCEMATCH"

    tag "modules"
    tag "modules_nfcore"
    tag "pdbesifts"
    tag "pdbesifts/sequencematch"

    test("cif - mmseqs") {

        when {
            process {
                """
                input[0] = [
                    [ id:'1cbs' ],
                    file('https://raw.githubusercontent.com/npechl/test-datasets/modules/data/proteomics/cif/1cbs.cif', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'yeast_UPS_mini' ],
                    file('https://raw.githubusercontent.com/npechl/test-datasets/modules/data/proteomics/database/yeast_UPS_mini.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    file(process.out.duckdb[0][1]).name,
                    process.out.tsv,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("cif - mmseqs - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'1cbs' ],
                    file('https://raw.githubusercontent.com/npechl/test-datasets/modules/data/proteomics/cif/1cbs.cif', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'yeast_UPS_mini' ],
                    file('https://raw.githubusercontent.com/npechl/test-datasets/modules/data/proteomics/database/yeast_UPS_mini.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
