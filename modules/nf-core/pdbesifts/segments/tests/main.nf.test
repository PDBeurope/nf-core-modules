nextflow_process {

    name "Test Process PDBESIFTS_SEGMENTS"
    script "../main.nf"
    process "PDBESIFTS_SEGMENTS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "pdbesifts"
    tag "pdbesifts/segments"

    test("1cbs - cif - accession mapping") {

        when {
            params {
                module_args = '-m A:P29373'
            }
            process {
                """
                input[0] = [
                    [ id:'1cbs' ],
                    file('https://raw.githubusercontent.com/npechl/test-datasets/modules/data/proteomics/cif/1cbs.cif', checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    path(process.out.seg[0][1]).linesGzip,
                    path(process.out.res[0][1]).linesGzip[0..4],
                    path(process.out.res[0][1]).linesGzip.size(),
                    path(process.out.delta[0][1]).linesGzip,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("1cbs - cif - accession mapping - stub") {

        options "-stub"

        when {
            params {
                module_args = '-m A:P29373'
            }
            process {
                """
                input[0] = [
                    [ id:'1cbs' ],
                    file('https://raw.githubusercontent.com/npechl/test-datasets/modules/data/proteomics/cif/1cbs.cif', checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
